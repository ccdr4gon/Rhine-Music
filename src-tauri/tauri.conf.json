{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhine Music",
  "version": "0.3.0",
  "identifier": "io.github.ccdr4gon.rhine-music",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "bootstrap"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["desktop"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "publisher": "ccdr4gon",
    "category": "Music",
    "shortDescription": "Local music in a three-dimensional album archive",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../dist/": "web/",
      "../启动播放器皮肤.cmd": "启动播放器皮肤.cmd"
    },
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "copyright": "Copyright (c) 2026 RonaldDeng and LBEILC; desktop adaptation by ccdr4gon",
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
